# Image for every TypeScript service and job in ops/docker-compose.yml
# (migrate, seed, api, reporting). Code runs directly from source with tsx,
# so dev dependencies are installed. Build context is the repo root.
#
# Debian slim rather than Alpine: argon2 and sharp ship prebuilt glibc binaries.
FROM node:22-bookworm-slim

WORKDIR /app

# Workspace manifests first so `npm ci` is cached until a dependency changes.
COPY package.json package-lock.json ./
COPY packages/money/package.json packages/money/
COPY packages/events/package.json packages/events/
COPY apps/api/package.json apps/api/
COPY apps/reporting/package.json apps/reporting/
COPY apps/web/package.json apps/web/
COPY apps/admin/package.json apps/admin/
RUN npm ci --no-audit --no-fund

COPY . .
