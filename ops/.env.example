# The variables ops/docker-compose.yml needs. Don't copy this file by hand:
# run ops/init-env.sh, which writes ops/.env with random values.
POSTGRES_PASSWORD=
# base64 of exactly 32 random bytes (openssl rand -base64 32)
WEBHOOK_SECRET_ENCRYPTION_KEY=
SETTLEMENT_INTERNAL_TOKEN=
ACQUIRER_CALLBACK_SIGNING_SECRET=
# Demo sandbox only (no OTP delivery channel exists): true shows the login OTP
# in the response. Leave false anywhere real users log in.
OTP_DEV_EXPOSE=false
